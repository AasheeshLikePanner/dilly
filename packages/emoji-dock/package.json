{
    "name": "@zynta/emoji-dock",
    "version": "1.0.4",
    "description": "Mac OS dock-style emoji feedback component for React",
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/index.mjs",
            "require": "./dist/index.js",
            "types": "./dist/index.d.ts"
        }
    },
    "files": [
        "dist",
        "README.md"
    ],
    "scripts": {
        "build": "npm run build:css && tsup src/index.tsx --format cjs,esm --dts --external react --external framer-motion --inject-style",
        "build:css": "npx @tailwindcss/cli -i style-input.css -o src/styles.css --minify",
        "dev": "tsup src/index.tsx --format cjs,esm --dts --watch --external react --external framer-motion",
        "prepublishOnly": "npm run build"
    },
    "peerDependencies": {
        "react": "^18.0.0",
        "framer-motion": "^10.0.0 || ^11.0.0"
    },
    "devDependencies": {
        "@types/react": "^18.2.0",
        "tsup": "^8.0.0",
        "typescript": "^5.3.0"
    },
    "keywords": [
        "react",
        "feedback",
        "emoji",
        "component",
        "ui",
        "dilly",
        "dock",
        "macos"
    ],
    "author": "Dilly",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/yourusername/dilly"
    }
}